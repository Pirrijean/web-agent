# ==============================================================================
# Configuración de Entorno para web-agent
# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA agregues .env al control de versiones (git).
# ==============================================================================

# --- Autenticación y Servicio REST (Evaluación Hackathon) ---
# Token obligatorio exigido en 'Authorization: Bearer <token>' para la evaluación
EVALUATION_BEARER_TOKEN=tu_bearer_token_secreto_aqui
# WEB_AGENT_BEARER_TOKEN=token_alternativo_si_aplica

HOST=0.0.0.0
PORT=8000
WEB_AGENT_MAX_BODY_BYTES=65536
WEB_AGENT_EXPOSE_DOCS=false

# --- Proveedor del Modelo VLM (Visión Multimodal) ---
# Opciones: openrouter | scripted
WEB_AGENT_MODEL_PROVIDER=openrouter
MODEL_NAME=google/gemini-2.0-flash-001
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WEB_AGENT_MODEL_TIMEOUT_SECONDS=60.0
WEB_AGENT_MAX_OUTPUT_TOKENS=1024
WEB_AGENT_MAX_MODEL_CALLS=60
WEB_AGENT_MAX_TASK_COST_USD=1.00
WEB_AGENT_PRICE_INPUT_PER_MTOK=0.10
WEB_AGENT_PRICE_OUTPUT_PER_MTOK=0.40
WEB_AGENT_MAX_IMAGE_BYTES=3500000

# --- Límites de Ejecución y Tiempos de Tarea ---
# Tope absoluto de tiempo por tarea en segundos (máximo permitido: 300 s)
TASK_TIMEOUT_SECONDS=300
MAX_CONCURRENT_TASKS=2
WEB_AGENT_WORKER_MODE=subprocess
WEB_AGENT_MAX_ACTIONS=40
WEB_AGENT_MAX_RECOVERY_ATTEMPTS=6
WEB_AGENT_ACTION_TIMEOUT_SECONDS=15.0
WEB_AGENT_CLEANUP_TIMEOUT_SECONDS=5.0
WEB_AGENT_OBSERVATION_MAX_AGE_SECONDS=15.0
WEB_AGENT_TYPING_DELAY_MS=20

# --- Entorno del Navegador Playwright ---
WEB_AGENT_HEADLESS=true
# true fuera de contenedores; la imagen Docker lo fija a false (el contenedor aísla)
WEB_AGENT_CHROMIUM_SANDBOX=true
WEB_AGENT_VIEWPORT_WIDTH=1280
WEB_AGENT_VIEWPORT_HEIGHT=800

# --- Red y Seguridad de Escritorio ---
WEB_AGENT_ALLOW_PRIVATE_DESKTOP=true
WEB_AGENT_ALLOW_LOOPBACK_DESKTOP=false

# --- Auditoría y Evidencias ---
WEB_AGENT_AUDIT_DIR=./data/audit
WEB_AGENT_PERSIST_SCREENSHOTS=false
WEB_AGENT_EVIDENCE_DIR=./data/evidence
