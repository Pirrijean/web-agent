{
    "skill_name": "playwright_browser_control",
    "description": "Control de navegador restringido. Las acciones se canalizan obligatoriamente por el núcleo de seguridad de web-agent.",
    "type": "mcp_server",
    "status": "enabled",
    "execution": {
        "command": "uv",
        "args": [
            "run",
            "python",
            "-m",
            "web_agent.mcp_servers.browser_server"
        ]
    },
    "security_policy": {
        "require_human_approval_for_destructive_actions": true,
        "allowed_domains": [
            "https://portal.example.com",
            "https://test.example.org"
        ]
    }
}